APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
GOOGLE_CLOUD_PROJECT=PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.1-flash-lite
VERTEX_DECISION_MODEL=gemini-3.1-flash-lite
GOOGLE_MAPS_API_KEY=
MAPS_MCP_URL=https://mapstools.googleapis.com/mcp
MAPS_TIMEOUT_SECONDS=30
MAPS_READ_TIMEOUT_SECONDS=90
GOOGLE_WEATHER_API_KEY=
GOOGLE_CLOUD_STORAGE_BUCKET=
FRONTEND_ORIGIN=http://localhost:3000
MAX_AGENT_MESSAGE_CHARS=12000
MAX_REQUEST_BODY_BYTES=1048576
WRITE_API_KEY_REQUIRED=false
INTERNAL_API_KEY=
MODEL_TIMEOUT_SECONDS=45
WEATHER_TIMEOUT_SECONDS=15
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
AUTH_TOKEN_SECRET=generate-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=86400
